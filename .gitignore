# ---------- Rust / Cargo ----------
/target
# cargo 构建时产生的临时 target 目录（target<随机后缀>）
/target*/
**/*.rs.bk
*.pdb

# 库 crate 不锁定依赖版本；如需可复现构建，删除下一行改为提交 Cargo.lock
Cargo.lock

# ---------- Node / 前端（web/）----------
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
# vite 临时产物
vite.config.js.timestamp-*.mjs

# ---------- WorkBuddy 本地数据 ----------
# 项目相关本地数据，不纳入版本管理（非临时缓存，勿删）
.workbuddy-ai/

# ---------- 日志与临时文件 ----------
*.log
logs/
*.tmp
*.temp
*.swp
*.swo

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# ---------- 编辑器 / IDE ----------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---------- 构建 / 打包产物 ----------
*.app
*.dmg
*.pkg
*.zip
